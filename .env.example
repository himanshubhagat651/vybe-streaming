# ==============================================================================
# VYBE — Environment Variables Configuration Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# Application
NEXT_PUBLIC_APP_NAME="VYBE"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# The Movie Database (TMDB) API
# Get your free API key at: https://www.themoviedb.org/settings/api
# ------------------------------------------------------------------------------
TMDB_API_KEY="your_tmdb_api_v3_key_here"
TMDB_READ_ACCESS_TOKEN="your_tmdb_v4_read_access_token_here"
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"

# ------------------------------------------------------------------------------
# ScreenScape Video Embed Provider
# Primary and fallback embed player endpoints
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SCREENSCAPE_EMBED_BASE_URL="https://web.screenscape.fun/embed"
NEXT_PUBLIC_SCREENSCAPE_FALLBACK_URL="https://nxsha.screenscape.me/embed"
NEXT_PUBLIC_DEFAULT_AUDIO_LANGUAGE="eng"

# ------------------------------------------------------------------------------
# Supabase Configuration (Authentication & PostgreSQL Database)
# Create a free project at: https://supabase.com/dashboard
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_public_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key_here"

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_AUTH="true"
NEXT_PUBLIC_ENABLE_GUEST_SYNC="true"
